# =============================================
# ESP32 NeoTrellis Box — .gitignore
# Covers: KiCAD, PlatformIO, ESP-IDF, editors
# =============================================

# ----- Compiled objects & libraries -----
*.o
*.obj
*.lo
*.slo
*.a
*.lib
*.la
*.lai
*.so
*.dylib
*.dll
*.exe
*.out
*.app
*.d
*.gch
*.pch

# ----- KiCAD -----
# Backup & autosave files
*~
*.bak
*-backups/
_autosave-*
*.kicad_prl
fp-info-cache

# ----- PlatformIO -----
.pio/
.pioenvs/
.piolibdeps/
.piorepo/

# ----- ESP-IDF -----
build/
sdkconfig.old
managed_components/

# ----- Python (build scripts, venvs) -----
__pycache__/
*.py[cod]
.venv/
venv/

# ----- Editors & IDEs -----
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
